# Alpine-Contributor: Duncan Bellamy <dunk@denkimushi.com>
# Alpine-Maintainer: Duncan Bellamy <dunk@denkimushi.com>
# Maintainer: Elliott Mazzuca <emazzuca@qnx.com>
pkgname=python3-hatch-vcs
pkgver=0.5.0
pkgrel=0
pkgdesc="Hatch plugin for versioning with your preferred VCS"
url="https://github.com/ofek/hatch-vcs"
arch="noarch"
license="MIT"
depends="python3 python3-hatchling python3-setuptools_scm"
makedepends="python3-gpep517 python3-installer python3-wheel"
source="https://files.pythonhosted.org/packages/source/h/hatch-vcs/hatch_vcs-$pkgver.tar.gz"
builddir="$srcdir/hatch_vcs-$pkgver"
options="!check" #pytest circular dep

build() {
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    .testenv/bin/python3 -m installer .dist/*.whl
    .testenv/bin/python3 -m pytest
}

package() {
    python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
75731f61b325ab757a681dfc4b28d78f998961b4f96ae0070209a7a1ac96a28e27beecedef41aed08e9538f4136dcac29a3cc5aa254af2d2ded921d7afb28951  hatch_vcs-0.5.0.tar.gz
"
